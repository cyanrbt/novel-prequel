{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state.schema.json",
  "title": "Novel prequel state",
  "type": "object",
  "required": [
    "schema",
    "machine_state",
    "chapter",
    "timeline",
    "protagonist",
    "characters",
    "world_lore",
    "active_foreshadows",
    "revealed_rules",
    "recent_hooks",
    "chapter_summaries"
  ],
  "properties": {
    "schema": {"const": "novel-prequel-state"},
    "machine_state": {
      "enum": ["IDLE", "INIT", "OUTLINE", "WRITE", "REVIEW", "RECOVERY", "ERROR", "WAITING_USER"]
    },
    "chapter": {
      "type": "object",
      "required": ["last_chapter", "next_chapter", "current_volume", "current_volume_name", "current_event", "current_event_name", "current_phase"]
    },
    "timeline": {"type": "object"},
    "protagonist": {"type": "object"},
    "characters": {"type": "object"},
    "world_lore": {"type": "object"},
    "active_foreshadows": {"type": "object"},
    "revealed_rules": {"type": "array"},
    "recent_hooks": {"type": "array"},
    "chapter_summaries": {"type": "object"},
    "last_review": {
      "type": "object",
      "required": ["chapter", "grade", "verdict", "timestamp"],
      "properties": {
        "chapter": {"type": "integer", "minimum": 1},
        "grade": {"type": "string"},
        "verdict": {"type": "string"},
        "timestamp": {"type": "string"},
        "draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reader_verdict": {"type": "string"},
        "mechanism_verdict": {"type": "string"},
        "taste_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "formal_review_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["draft_sha256", "reader_verdict", "mechanism_verdict", "taste_contract_sha256", "reviewed_at"],
        "properties": {
          "draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reader_verdict": {"type": "string"},
          "mechanism_verdict": {"type": "string"},
          "taste_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reviewed_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}

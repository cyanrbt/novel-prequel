{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style_comparison.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "calibration_id", "source_fingerprint", "candidate_fingerprints", "ranking", "preferred_candidate", "confidence", "dimension_winners", "candidate_findings", "all_candidates_need_revision", "decision_reasons", "user_questions"],
  "properties": {
    "schema": {"const": "novel-style-comparison"},
    "calibration_id": {"type": "string", "minLength": 1},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C"],
      "properties": {
        "A": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "B": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "C": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ranking": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["A", "B", "C"]}
    },
    "preferred_candidate": {"enum": ["A", "B", "C"]},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "dimension_winners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["natural_narration", "character_presence", "explanation_restraint", "horror_causality", "dialogue_voice", "serial_pull"],
      "properties": {
        "natural_narration": {"enum": ["A", "B", "C", "TIE"]},
        "character_presence": {"enum": ["A", "B", "C", "TIE"]},
        "explanation_restraint": {"enum": ["A", "B", "C", "TIE"]},
        "horror_causality": {"enum": ["A", "B", "C", "TIE"]},
        "dialogue_voice": {"enum": ["A", "B", "C", "TIE"]},
        "serial_pull": {"enum": ["A", "B", "C", "TIE"]}
      }
    },
    "candidate_findings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "strengths", "gaps"],
        "anyOf": [
          {"properties": {"strengths": {"minItems": 1}}},
          {"properties": {"gaps": {"minItems": 1}}}
        ],
        "properties": {
          "candidate": {"enum": ["A", "B", "C"]},
          "strengths": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
          "gaps": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
        }
      }
    },
    "all_candidates_need_revision": {"type": "boolean"},
    "decision_reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "user_questions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "finding"],
      "properties": {
        "quote": {"type": "string", "minLength": 1},
        "finding": {"type": "string", "minLength": 1}
      }
    }
  }
}

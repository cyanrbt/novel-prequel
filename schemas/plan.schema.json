{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["chapter_number", "title", "event_id", "phase", "chapter_purpose", "reader_investment", "dramatic_spine", "scenes", "new_information", "state_changes", "rule_hypotheses", "canon_evidence_ids", "foreshadow_operations", "milestone_operations", "hook", "prohibited_elements"],
  "properties": {
    "chapter_number": {"type": "integer", "minimum": 1},
    "title": {"type": "string"},
    "event_id": {"type": "string"},
    "phase": {"type": "string"},
    "chapter_purpose": {"type": "string"},
    "reader_investment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment_anchor", "protagonist_contradiction", "threat_in_motion", "revelation_shift", "emotional_afterimage", "clue_delivery"],
      "properties": {
        "attachment_anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["focus", "on_page_moment", "private_meaning", "threatened_loss"],
          "properties": {
            "focus": {"type": "string"},
            "on_page_moment": {"type": "string"},
            "private_meaning": {"type": "string"},
            "threatened_loss": {"type": "string"}
          }
        },
        "protagonist_contradiction": {"type": "string"},
        "threat_in_motion": {"type": "string"},
        "revelation_shift": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "changes"],
          "properties": {
            "from": {"type": "string"},
            "to": {"type": "string"},
            "changes": {"type": "string", "enum": ["IDENTITY", "RELATIONSHIP", "SAFETY", "ACTION_RULE", "MORAL_CHOICE"]}
          }
        },
        "emotional_afterimage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["person", "immediate_wound", "unresolved_choice", "mystery_subordinate_to"],
          "properties": {
            "person": {"type": "string"},
            "immediate_wound": {"type": "string"},
            "unresolved_choice": {"type": "string"},
            "mystery_subordinate_to": {"type": "string"}
          }
        },
        "clue_delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "resistance", "coincidence_risk"],
          "properties": {
            "method": {"type": "string"},
            "resistance": {"type": "string"},
            "coincidence_risk": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]}
          }
        }
      }
    },
    "dramatic_spine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening_pressure", "opening_genre_signal", "protagonist_immediate_want", "personal_stake", "destabilizing_event", "protagonist_choice", "choice_cost", "cost_realization", "relationship_friction", "question_progression", "emotional_turn", "serial_promise", "ending_leverage"],
      "properties": {
        "opening_pressure": {"type": "string"},
        "opening_genre_signal": {"type": "string"},
        "protagonist_immediate_want": {"type": "string"},
        "personal_stake": {"type": "string"},
        "destabilizing_event": {"type": "string"},
        "protagonist_choice": {"type": "string"},
        "choice_cost": {"type": "string"},
        "cost_realization": {"type": "string"},
        "relationship_friction": {"type": "string"},
        "question_progression": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {"type": "string"}
        },
        "emotional_turn": {"type": "string"},
        "serial_promise": {"type": "string"},
        "ending_leverage": {"type": "string"}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "characters", "goal", "conflict", "function", "initial_state", "discovery_path", "knowledge_limits", "ordinary_explanations", "choice_reason", "end_state", "pressure_change", "irreversible_change", "threat_action", "human_turn", "payoff_type"],
        "properties": {
          "location": {"type": "string"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "goal": {"type": "string"},
          "conflict": {"type": "string"},
          "function": {"type": "string"},
          "initial_state": {"type": "string"},
          "discovery_path": {"type": "string"},
          "knowledge_limits": {"type": "string"},
          "ordinary_explanations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["considered", "excluded", "remaining"],
            "properties": {
              "considered": {"type": "array", "items": {"type": "string"}},
              "excluded": {"type": "array", "items": {"type": "string"}},
              "remaining": {"type": "array", "items": {"type": "string"}}
            }
          },
          "choice_reason": {"type": "string"},
          "end_state": {"type": "string"},
          "pressure_change": {"type": "string"},
          "irreversible_change": {"type": "string"},
          "threat_action": {"type": "string"},
          "human_turn": {"type": "string"},
          "payoff_type": {"type": "string", "enum": ["HUMAN_CHANGE", "MIXED", "EVIDENCE_ONLY"]}
        }
      }
    },
    "new_information": {"type": "array", "items": {"type": "string"}},
    "state_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protagonist_known_info_add", "protagonist_inventory_add", "protagonist_inventory_remove", "protagonist_location", "protagonist_body_updates", "ability_updates", "timeline_year", "timeline_elapsed_days", "character_updates", "world_confirmed_add", "world_hypotheses_add"],
      "properties": {
        "protagonist_known_info_add": {"type": "array", "items": {"type": "string"}},
        "protagonist_inventory_add": {"type": "array", "items": {"type": "string"}},
        "protagonist_inventory_remove": {"type": "array", "items": {"type": "string"}},
        "protagonist_location": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "protagonist_body_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": {"key": {"type": "string"}, "value": {"type": "string"}}
          }
        },
        "ability_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {"name": {"type": "string"}, "status": {"type": "string"}}
          }
        },
        "timeline_year": {"type": "integer", "minimum": 1890, "maximum": 1950},
        "timeline_elapsed_days": {"type": "integer", "minimum": 0},
        "character_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "note"],
            "properties": {"name": {"type": "string"}, "status": {"type": "string"}, "note": {"type": "string"}}
          }
        },
        "world_confirmed_add": {"type": "array", "items": {"type": "string"}},
        "world_hypotheses_add": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rule_hypotheses": {"type": "array", "items": {"type": "string"}},
    "canon_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "foreshadow_operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plant", "recover"],
      "properties": {
        "plant": {"type": "array", "items": {"type": "string"}},
        "recover": {"type": "array", "items": {"type": "string"}}
      }
    },
    "milestone_operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete"],
      "properties": {"complete": {"type": "array", "items": {"type": "string"}}}
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {"type": {"type": "string"}, "content": {"type": "string"}}
    },
    "prohibited_elements": {"type": "array", "items": {"type": "string"}}
  }
}

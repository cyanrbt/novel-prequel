{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character_intention.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "source_fingerprint", "tick", "actor_id", "action_id", "immediate_want", "chosen_action", "target", "expected_result", "fallback_action", "withheld_information", "emotional_pressure", "used_fact_ids", "uses_forbidden_author_knowledge"],
  "properties": {
    "schema": {"const": "novel-character-intention"},
    "experiment_id": {"type": "string", "minLength": 1},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tick": {"type": "integer", "minimum": 1, "maximum": 9},
    "actor_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "action_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "immediate_want": {"type": "string", "minLength": 1},
    "chosen_action": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "expected_result": {"type": "string", "minLength": 1},
    "fallback_action": {"type": "string", "minLength": 1},
    "withheld_information": {"type": "string"},
    "emotional_pressure": {"type": "string", "minLength": 1},
    "used_fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_-]+$"}},
    "uses_forbidden_author_knowledge": {"const": false}
  }
}

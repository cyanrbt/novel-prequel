{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reader_review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["chapter_number", "draft_sha256", "verdict", "reader_recap", "adversarial_checks", "pacing_diagnostics", "reading_experience", "benchmark_comparison", "blocking_issues", "warnings", "evidence", "revision_instructions"],
  "properties": {
    "chapter_number": {"type": "integer", "minimum": 1},
    "draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"type": "string", "enum": ["PASS", "REVISE", "REPLAN"]},
    "reader_recap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_goal", "character_positions", "spatial_map", "causal_chain", "next_question"],
      "properties": {
        "current_goal": {"type": "string"},
        "character_positions": {"type": "string"},
        "spatial_map": {"type": "string"},
        "causal_chain": {"type": "string"},
        "next_question": {"type": "string"}
      }
    },
    "adversarial_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinary_explanations", "missing_preconditions", "knowledge_or_behavior_gaps", "physical_or_spatial_gaps", "unsupported_recap_claims"],
      "properties": {
        "ordinary_explanations": {"type": "array", "items": {"type": "string"}},
        "missing_preconditions": {"type": "array", "items": {"type": "string"}},
        "knowledge_or_behavior_gaps": {"type": "array", "items": {"type": "string"}},
        "physical_or_spatial_gaps": {"type": "array", "items": {"type": "string"}},
        "unsupported_recap_claims": {"type": "array", "items": {"type": "string"}}
      }
    },
    "pacing_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_1000_chars_result", "first_active_pressure", "core_threat_activation", "first_costly_choice", "pressure_turns", "max_pressure_gap_chars", "exposition_runs", "information_only_passages"],
      "properties": {
        "first_1000_chars_result": {"type": "string"},
        "first_active_pressure": {"$ref": "#/$defs/pacingMilestone"},
        "core_threat_activation": {"$ref": "#/$defs/pacingMilestone"},
        "first_costly_choice": {"$ref": "#/$defs/pacingMilestone"},
        "pressure_turns": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/pressureTurn"}
        },
        "max_pressure_gap_chars": {"type": "integer", "minimum": 0},
        "exposition_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/expositionRun"}
        },
        "information_only_passages": {
          "type": "array",
          "items": {"$ref": "#/$defs/informationOnlyPassage"}
        }
      }
    },
    "reading_experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prose_accessibility", "character_believability", "target_emotion_effect", "narrative_momentum", "opening_pull", "protagonist_ownership", "question_progression", "ending_compulsion", "competitive_readiness", "next_click_reason", "continue_reading", "first_drop_point", "friction_reasons", "friction_severity"],
      "properties": {
        "prose_accessibility": {"type": "integer", "minimum": 1, "maximum": 5},
        "character_believability": {"type": "integer", "minimum": 1, "maximum": 5},
        "target_emotion_effect": {"type": "integer", "minimum": 1, "maximum": 5},
        "narrative_momentum": {"type": "integer", "minimum": 1, "maximum": 5},
        "opening_pull": {"type": "integer", "minimum": 1, "maximum": 5},
        "protagonist_ownership": {"type": "integer", "minimum": 1, "maximum": 5},
        "question_progression": {"type": "integer", "minimum": 1, "maximum": 5},
        "ending_compulsion": {"type": "integer", "minimum": 1, "maximum": 5},
        "competitive_readiness": {"type": "string", "enum": ["BELOW", "NEAR", "MATCH"]},
        "next_click_reason": {"type": "string"},
        "continue_reading": {"type": "boolean"},
        "first_drop_point": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote", "explanation"],
              "properties": {
                "quote": {"type": "string"},
                "explanation": {"type": "string"}
              }
            }
          ]
        },
        "friction_reasons": {"type": "array", "items": {"type": "string"}},
        "friction_severity": {"type": "string", "enum": ["NONE", "MINOR", "MAJOR"]}
      }
    },
    "benchmark_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_attachment", "active_threat", "protagonist_specificity", "revelation_transformation", "emotional_aftereffect", "evidence_payoff_mode", "would_choose_over_competent_peer", "major_gaps"],
      "properties": {
        "character_attachment": {"$ref": "#/$defs/benchmarkDimension"},
        "active_threat": {"$ref": "#/$defs/benchmarkDimension"},
        "protagonist_specificity": {"$ref": "#/$defs/benchmarkDimension"},
        "revelation_transformation": {"$ref": "#/$defs/benchmarkDimension"},
        "emotional_aftereffect": {"$ref": "#/$defs/benchmarkDimension"},
        "evidence_payoff_mode": {"type": "string", "enum": ["HUMAN_CHANGE", "MIXED", "EVIDENCE_ONLY"]},
        "would_choose_over_competent_peer": {"type": "boolean"},
        "major_gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "quote", "reader_question", "explanation"],
        "properties": {
          "code": {"type": "string"},
          "quote": {"type": "string"},
          "reader_question": {"type": "string"},
          "explanation": {"type": "string"}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "quote", "explanation"],
        "properties": {
          "code": {"type": "string"},
          "quote": {"type": "string"},
          "explanation": {"type": "string"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "finding"],
        "properties": {"quote": {"type": "string"}, "finding": {"type": "string"}}
      }
    },
    "revision_instructions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "pacingMilestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "position_percent", "effect"],
      "properties": {
        "quote": {"type": "string"},
        "position_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "effect": {"type": "string"}
      }
    },
    "pressureTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "effect"],
      "properties": {
        "quote": {"type": "string"},
        "effect": {"type": "string"}
      }
    },
    "expositionRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "paragraph_count", "approx_chars", "explanation"],
      "properties": {
        "quote": {"type": "string"},
        "paragraph_count": {"type": "integer", "minimum": 1},
        "approx_chars": {"type": "integer", "minimum": 1},
        "explanation": {"type": "string"}
      }
    },
    "informationOnlyPassage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "approx_chars", "explanation"],
      "properties": {
        "quote": {"type": "string"},
        "approx_chars": {"type": "integer", "minimum": 1},
        "explanation": {"type": "string"}
      }
    },
    "benchmarkDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "quote", "assessment"],
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "quote": {"type": "string"},
        "assessment": {"type": "string"}
      }
    }
  }
}
